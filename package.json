{
  "name": "victorhugosalviano.com",
  "version": "1.0.0",
  "private": true,
  "description": "Site pessoal e currículo de Victor Hugo Salviano (Next.js com exportação estática).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsx scripts/csp-hashes.ts",
    "preview": "node scripts/serve.mjs 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:rules": "node scripts/check-rules.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run check:rules && tsx scripts/brand-colors.ts --check && npm run build",
    "screenshots": "tsx scripts/screenshots.ts",
    "brand-colors": "tsx scripts/brand-colors.ts",
    "optimize-images": "tsx scripts/optimize-images.ts",
    "pixel-art": "tsx scripts/pixel-art.ts",
    "sync-curriculo": "tsx scripts/sync-curriculo.ts",
    "deploy:dry-run": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@tabler/icons-react": "3.52.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "16.38.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "wrangler": "4.162.0"
  }
}
